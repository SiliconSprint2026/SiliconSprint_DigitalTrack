# SiliconSprint 2026 - build all bare-metal test programs.
#
#   make            build everything into build/
#   make clean
#
# Layout:
#   directed/*.c          L1 self-checking directed tests (one ELF each)
#   hazard/*.S|*.c        L2 hazard tests
#   kernels/*.c           bonus-track kernels (+ kernels/vec/<name>_vec.c)
#   random/*.S            L3 random tests (generated by tools/rand_gen.py)
#   <extra dirs>          EXTRA_DIRS="path/a path/b" adds more test dirs
#                         (the organizers use this for hidden tests)

PREFIX   ?= riscv64-unknown-elf-
CC       := $(PREFIX)gcc
OBJDUMP  := $(PREFIX)objdump
BUILD    ?= build

ARCH     ?= rv64gc
ABI      ?= lp64d
CFLAGS   := -march=$(ARCH) -mabi=$(ABI) -mcmodel=medany -O2 -g -static \
            -nostdlib -nostartfiles -ffreestanding -fno-builtin \
            -fno-tree-loop-distribute-patterns -Wall -Icommon
LDFLAGS  := -T common/link.ld -Wl,--no-warn-rwx-segments
COMMON   := common/crt.S common/htif.c

DIRECTED := vadd vsub vand vor vxor $(basename $(notdir $(filter-out directed/vadd.c directed/vsub.c directed/vlogic.c,$(wildcard directed/*.c directed/*.S))))
HAZARD   := $(basename $(notdir $(wildcard hazard/*.S hazard/*.c)))
KERNELS  := $(basename $(notdir $(wildcard kernels/*.c)))
RANDOM   := $(basename $(notdir $(wildcard random/*.S)))
EXTRA_DIRS ?=
EXTRA    := $(foreach d,$(EXTRA_DIRS),$(addprefix $(notdir $(d))__,$(basename $(notdir $(wildcard $(d)/*.c $(d)/*.S)))))

ELFS := $(addprefix $(BUILD)/directed/,$(addsuffix .elf,$(DIRECTED))) \
        $(addprefix $(BUILD)/hazard/,$(addsuffix .elf,$(HAZARD)))     \
        $(addprefix $(BUILD)/kernels/,$(addsuffix .elf,$(KERNELS)))   \
        $(addprefix $(BUILD)/random/,$(addsuffix .elf,$(RANDOM)))     \
        $(addprefix $(BUILD)/extra/,$(addsuffix .elf,$(EXTRA)))

all: $(ELFS)

define link
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(1) $(COMMON) $(LDFLAGS) -o $@
	@$(OBJDUMP) -d $@ > $(@:.elf=.dump)
endef

# Directed tests. vand/vor/vxor share one source.
$(BUILD)/directed/vand.elf: directed/vlogic.c $(COMMON) common/*.h
	$(call link,-DOP_vand $<)
$(BUILD)/directed/vor.elf: directed/vlogic.c $(COMMON) common/*.h
	$(call link,-DOP_vor $<)
$(BUILD)/directed/vxor.elf: directed/vlogic.c $(COMMON) common/*.h
	$(call link,-DOP_vxor $<)
$(BUILD)/directed/%.elf: directed/%.c $(COMMON) common/*.h
	$(call link,$<)
$(BUILD)/directed/%.elf: directed/%.S $(COMMON) common/*.h
	$(call link,$<)

$(BUILD)/hazard/%.elf: hazard/%.S $(COMMON) common/*.h
	$(call link,$<)
$(BUILD)/hazard/%.elf: hazard/%.c $(COMMON) common/*.h
	$(call link,$<)

$(BUILD)/kernels/%.elf: kernels/%.c kernels/vec/%_vec.c $(COMMON) common/*.h kernels/kernel_common.h
	$(call link,$< kernels/vec/$*_vec.c)

$(BUILD)/random/%.elf: random/%.S $(COMMON) common/*.h
	$(call link,$<)

# Extra test directories: build/extra/<dir>__<test>.elf
define extra_rule
$(BUILD)/extra/$(notdir $(1))__%.elf: $(1)/%.c $(COMMON) common/*.h
	$$(call link,$$<)
$(BUILD)/extra/$(notdir $(1))__%.elf: $(1)/%.S $(COMMON) common/*.h
	$$(call link,$$<)
endef
$(foreach d,$(EXTRA_DIRS),$(eval $(call extra_rule,$(d))))

clean:
	rm -rf $(BUILD)

.PHONY: all clean
